{
  "expo": {
    "name": "PipWise",
    "slug": "pipwise",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/android-icon-backgrounds.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.pipwise.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-backgrounds.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "io.pipwise.app"
    },
    "web": {
      "favicon": "./assets/android-icon-backgrounds.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0D1011",
          "image": "./assets/android-icon-backgrounds.png",
          "imageWidth": 96,
          "resizeMode": "contain"
        }
      ]
    ],
    "scheme": "pipwise"
  }
}
