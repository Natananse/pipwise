{
  "expo": {
    "name": "PipWise",
    "slug": "pipwise",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/android-icon-backgrounds.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.pipwise.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-backgrounds.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "io.pipwise.app"
    },
    "web": {
      "favicon": "./assets/android-icon-backgrounds.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser"
    ],
    "scheme": "pipwise"
  }
}