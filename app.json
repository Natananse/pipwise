{
  "expo": {
    "name": "PipWise",
    "slug": "pipwise",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/android-icon-backgrounds.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0D1011",
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": true,
      "bundleIdentifier": "io.pipwise.app"
    },
    "android": {
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-backgrounds.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "package": "io.pipwise.app",
      "versionCode": 4
    },
    "web": {
      "output": "server",
      "favicon": "./assets/android-icon-backgrounds.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-system-ui",
      ["expo-screen-orientation", { "initialOrientation": "PORTRAIT_UP" }],
      [
        "expo-status-bar",
        { "style": "light", "hidden": false }
      ],
      [
        "expo-navigation-bar",
        { "style": "light", "hidden": false, "enforceContrast": false }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0D1011",
          "image": "./assets/android-icon-backgrounds.png",
          "imageWidth": 96,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      "./plugins/withPortraitLaunch.cjs"
    ],
    "scheme": "pipwise",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "65b6f1aa-e283-46bd-8c3c-ad8ba7205c4b"
      }
    },
    "owner": "natananse"
  }
}
