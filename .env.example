# Copy to .env (never commit it). EXPO_PUBLIC_ values are bundled in the app.
# Public branch service URLs only: no passwords, API keys, or access tokens.
# After neon deploy / neon env pull, run node scripts/sync-neon-env.mjs.
EXPO_PUBLIC_NEON_AUTH_URL=https://your-neon-auth-host/neondb/auth
# Social sign-in opens the system browser on Android/iOS and uses Neon Auth.
# Deploy public/native-auth.html and trust its HTTPS origin in Neon first.
# Configure your own Google web OAuth credentials in Neon before production.
# This browser flow does not need Google native client IDs or SDK packages.
EXPO_PUBLIC_GOOGLE_AUTH_ENABLED=0
# Keep Apple off for the current Android-only release. Future iOS releases
# offering Google also offer Apple for App Review guideline 4.8.
# Configure Apple's Services ID, .p8 key, Team ID and Key ID in Neon first.
EXPO_PUBLIC_APPLE_AUTH_ENABLED=0
EXPO_PUBLIC_NATIVE_AUTH_RETURN_URL=https://pipwise--beta.expo.app/native-auth.html
# Required explicit API HTTPS origin for standalone preview/production builds.
# This maintained hosting alias is independent of Metro and port 8081.
# Set the same value in both EAS build environments; web uses same-origin routes.
EXPO_PUBLIC_APP_API_URL=https://pipwise--beta.expo.app
EXPO_PUBLIC_RC_ANDROID_KEY=
EXPO_PUBLIC_RC_IOS_KEY=

# Optional public HTTPS origin (or full /api/market URL) for the Market desk.
# Android needs a deployed API; leaving this blank shows Not connected.
# Web uses its own /api/market endpoint when blank. Never put a provider key here.
EXPO_PUBLIC_MARKET_API_URL=

# Private SERVER-ONLY provider setup. Keep disabled while access is pending.
# Set the gate to 1 only after the provider permits your public app's display,
# caching and derived analytics. Free account access alone does not grant this.
MARKET_DATA_DISPLAY_ALLOWED=0
TWELVE_DATA_API_KEY=
MARKETAUX_API_KEY=
# Explicit provider symbols for oil/index coverage, only when entitled.
# Example shape (fill provider-verified symbols): {"WTI/USD":"...","SPX/USD":"..."}
TWELVE_DATA_SYMBOLS_JSON=

# Optional server-only photo review. Keep disabled for the zero-budget beta.
# Local file studies and the manual ChatGPT handoff do not need these keys.
# Never use an EXPO_PUBLIC_ prefix for model/billing/database credentials.
CHART_COACH_ENABLED=0
CHART_COACH_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
CHART_COACH_MONTHLY_LIMIT=10
CHART_COACH_GLOBAL_MONTHLY_LIMIT=50
# Legacy optional Gemini service also requires RevenueCat subscriptions.
GEMINI_API_KEY=
GEMINI_MODEL=
REVENUECAT_SECRET_KEY=

# Optional dedicated Gmail sender for auth email setup. Owner enables 2-Step
# Verification and generates an App Password. Never use the account password.
# These fields do not switch the active Neon sender or enable email webhooks.
PIPWISE_SMTP_USER=
PIPWISE_SMTP_APP_PASSWORD=
PIPWISE_AUTH_EMAIL_ENABLED=0
PIPWISE_AUTH_EMAIL_RELAY_URL=
PIPWISE_AUTH_EMAIL_RELAY_SECRET=
# Email-only Node relay policy uses explicit credentials for the existing app:
PIPWISE_ORIGIN_AUTH_BASE_URL=
PIPWISE_ORIGIN_AUTH_JWKS_URL=
PIPWISE_AUTH_DATABASE_URL=

# Private local/server values populated by neon env pull. Never prefix these
# with EXPO_PUBLIC_, commit .env, or upload the complete file to EAS.
# DATABASE_URL: pooled Postgres connection; includes database credentials.
# DATABASE_URL_UNPOOLED: direct Postgres connection used by pnpm db:migrate.
# NEON_AUTH_BASE_URL: source for EXPO_PUBLIC_NEON_AUTH_URL (includes its path).
# NEON_AUTH_JWKS_URL: server-side JWT verification endpoint.
