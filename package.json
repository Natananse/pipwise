{
  "name": "pipwise-expo",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/manrope": "^0.4.3",
    "@expo/vector-icons": "^15.0.2",
    "@neon/auth": "^0.8.2",
    "@neon/config": "^1.10.0",
    "@neon/env": "^1.6.8",
    "@neondatabase/serverless": "^1.2.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.118.0",
    "expo": "~58.0.23",
    "expo-application": "~58.1.2",
    "expo-auth-session": "~58.0.17",
    "expo-blur": "~58.0.5",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.7",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.16",
    "expo-navigation-bar": "~58.0.4",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.7",
    "jose": "^6.2.15",
    "nodemailer": "^10.3.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-purchases": "^11.0.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "build": "expo export --platform all",
    "start": "expo start --port 8081",
    "start:setup": "EXPO_PUBLIC_PREVIEW_ONBOARDING=1 expo start --clear --port 8081",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web --port 8081",
    "native:prebuild": "expo prebuild --platform android",
    "android:build": "cd android && ./gradlew assembleDebug",
    "android:run": "expo run:android",
    "android:clean": "cd android && ./gradlew clean",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node scripts/migrate-neon.mjs",
    "beta:check": "node scripts/check-beta.mjs",
    "beta:android": "pnpm beta:check --profile preview && pnpm dlx eas-cli@latest build --platform android --profile preview",
    "beta:ios": "pnpm beta:check --profile testflight && pnpm dlx eas-cli@latest build --platform ios --profile testflight",
    "beta:ios:submit": "pnpm dlx eas-cli@latest submit --platform ios --profile testflight"
  },
  "private": true,
  "packageManager": "pnpm@11.20.0"
}
